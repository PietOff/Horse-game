rules_version = '2';

// Apeiron Derby — leaderboard security rules.
//
// The `derbyScores` collection is a public arcade leaderboard:
//   - anyone may READ it (every tablet sees the live board),
//   - anyone may CREATE a score, but only with a valid, minimal shape,
//   - anyone may DELETE a score (so the in-app Admin controls can remove
//     individual test times / clear the board). This is a fun board, not
//     sensitive data — the PIN in the app just hides the buttons.
//   - no one may EDIT an existing score.
//
// IMPORTANT — reusing the Apeiron project:
// Copy ONLY the `match /derbyScores/... { }` block below into that project's
// existing firestore.rules (do NOT replace the whole file, or you'll wipe the
// app's own rules), then deploy:  firebase deploy --only firestore:rules
// (or paste in Firebase console → Firestore Database → Rules → Publish).

service cloud.firestore {
  match /databases/{database}/documents {

    match /derbyScores/{id} {
      allow read: if true;
      allow create: if
        request.resource.data.keys().hasOnly(['name','ms','t','createdAt']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 20 &&
        request.resource.data.ms is number &&
        request.resource.data.ms >= 0 &&
        request.resource.data.t is number &&
        request.resource.data.createdAt is number;
      allow delete: if true;
      allow update: if false;
    }

  }
}
