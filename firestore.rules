rules_version = '2';

// Apeiron Derby — leaderboard security rules.
//
// The `derbyScores` collection is a public arcade leaderboard:
//   - anyone may READ it (so every tablet sees the live board),
//   - anyone may CREATE a score, but only with a valid, minimal shape,
//   - no one may edit or delete from the client (tidy up in the console).
//
// If you are REUSING the Apeiron project, copy ONLY the `match /derbyScores/...`
// block below into that project's existing firestore.rules (do not replace the
// whole file), then run:  firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    match /derbyScores/{id} {
      allow read: if true;
      allow create: if
        request.resource.data.keys().hasOnly(['name','ms','t','createdAt']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 20 &&
        request.resource.data.ms is number &&
        request.resource.data.ms >= 0 &&
        request.resource.data.t is number &&
        request.resource.data.createdAt is number;
      allow update, delete: if false;
    }

  }
}
